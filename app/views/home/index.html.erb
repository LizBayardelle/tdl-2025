<div style="background: var(--background);">
  <!-- Hero Section -->
  <div style="position: relative; background: linear-gradient(135deg, var(--primary) 0%, #3d4d22 100%); color: white; padding: 4rem 1.5rem; overflow: hidden;">
    <!-- Decorative elements -->
    <div style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; opacity: 0.1; background-image:
      radial-gradient(circle at 20% 50%, rgba(255,255,255,0.15) 0%, transparent 50%),
      radial-gradient(circle at 80% 30%, rgba(255,255,255,0.1) 0%, transparent 50%),
      radial-gradient(circle at 40% 80%, rgba(255,255,255,0.1) 0%, transparent 50%);
    "></div>

    <!-- Subtle grid pattern -->
    <div style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; opacity: 0.03; background-image:
      linear-gradient(rgba(255,255,255,0.1) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.1) 1px, transparent 1px);
      background-size: 50px 50px;
    "></div>

    <div style="max-width: 1200px; margin: 0 auto; position: relative; z-index: 1;">
      <div style="max-width: 900px; margin: 0 auto;">
        <div style="display: inline-block; background: rgba(255, 255, 255, 0.15); padding: 0.5rem 1rem; border-radius: 100px; margin-bottom: 1.5rem;">
          <span style="font-family: var(--font-body); font-size: var(--text-sm); font-weight: 500; letter-spacing: 0.05em;">FOR RESEARCHERS & ACADEMICS</span>
        </div>

        <h1 style="font-family: var(--font-display); font-size: 3.5rem; font-weight: 700; line-height: 1.2; margin-bottom: 1.5rem; letter-spacing: -0.02em;">
          A knowledge management system built for the way research actually works
        </h1>
        <p style="font-family: var(--font-body); font-size: 1.25rem; line-height: 1.6; color: rgba(255, 255, 255, 0.9); margin-bottom: 2.5rem;">
          Map My Research helps you build interconnected knowledge frameworks through concept networks, semantic tagging, and powerful filtering. Stop collecting notes in silos—start seeing the big picture.
        </p>
        <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
          <% if user_signed_in? %>
            <%= link_to dashboard_path, style: "background: white; color: var(--primary); padding: 1rem 2rem; border-radius: 4px; font-family: var(--font-display); font-size: var(--text-base); font-weight: 600; text-decoration: none; transition: all 0.15s; display: inline-flex; align-items: center; box-shadow: var(--shadow-lg);" do %>
              Go to Dashboard <i class="fas fa-arrow-right" style="margin-left: 0.5rem;"></i>
            <% end %>
          <% else %>
            <%= link_to new_user_registration_path, style: "background: white; color: var(--primary); padding: 1rem 2rem; border-radius: 4px; font-family: var(--font-display); font-size: var(--text-base); font-weight: 600; text-decoration: none; transition: all 0.15s; display: inline-flex; align-items: center; box-shadow: var(--shadow-lg);" do %>
              Get Started Free <i class="fas fa-arrow-right" style="margin-left: 0.5rem;"></i>
            <% end %>
            <%= link_to new_user_session_path, style: "background: transparent; color: white; padding: 1rem 2rem; border-radius: 4px; border: 2px solid rgba(255, 255, 255, 0.4); font-family: var(--font-display); font-size: var(--text-base); font-weight: 600; text-decoration: none; transition: all 0.15s; display: inline-flex; align-items: center;" do %>
              Sign In
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Problem Section -->
  <div style="padding: 5rem 1.5rem; background: white;">
    <div style="max-width: 1200px; margin: 0 auto;">
      <div style="text-align: center; margin-bottom: 3rem;">
        <h2 style="font-family: var(--font-display); font-size: 2.5rem; font-weight: 700; color: var(--neutral-900); margin-bottom: 1rem; letter-spacing: -0.02em;">
          You're drowning in notes. We get it.
        </h2>
        <p style="font-family: var(--font-body); font-size: 1.125rem; color: var(--neutral-600); max-width: 700px; margin: 0 auto; line-height: 1.6;">
          Traditional note-taking apps force you into a linear structure. But research happens in networks, connections, and evolving frameworks.
        </p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 2rem; margin-top: 3rem;">
        <!-- Pain Point 1 -->
        <div style="background: var(--neutral-100); padding: 2rem; border-radius: 4px;">
          <div style="width: 48px; height: 48px; background: var(--error); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-bottom: 1rem;">
            <i class="fas fa-file-alt" style="color: white; font-size: 1.25rem;"></i>
          </div>
          <h3 style="font-family: var(--font-display); font-size: var(--text-lg); font-weight: 600; color: var(--neutral-900); margin-bottom: 0.5rem;">
            Notes in silos
          </h3>
          <p style="font-family: var(--font-body); font-size: var(--text-sm); color: var(--neutral-600); line-height: 1.6;">
            Your insights from Paper A don't connect to Paper B. Concepts remain isolated. You rebuild the wheel every time you write.
          </p>
        </div>

        <!-- Pain Point 2 -->
        <div style="background: var(--neutral-100); padding: 2rem; border-radius: 4px;">
          <div style="width: 48px; height: 48px; background: var(--warning); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-bottom: 1rem;">
            <i class="fas fa-search" style="color: white; font-size: 1.25rem;"></i>
          </div>
          <h3 style="font-family: var(--font-display); font-size: var(--text-lg); font-weight: 600; color: var(--neutral-900); margin-bottom: 0.5rem;">
            Lost in the search
          </h3>
          <p style="font-family: var(--font-body); font-size: var(--text-sm); color: var(--neutral-600); line-height: 1.6;">
            "I know I read something about this..." Six months later, you still can't find that crucial citation or insight.
          </p>
        </div>

        <!-- Pain Point 3 -->
        <div style="background: var(--neutral-100); padding: 2rem; border-radius: 4px;">
          <div style="width: 48px; height: 48px; background: var(--accent-purple); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-bottom: 1rem;">
            <i class="fas fa-project-diagram" style="color: white; font-size: 1.25rem;"></i>
          </div>
          <h3 style="font-family: var(--font-display); font-size: var(--text-lg); font-weight: 600; color: var(--neutral-900); margin-bottom: 0.5rem;">
            No big picture
          </h3>
          <p style="font-family: var(--font-body); font-size: var(--text-sm); color: var(--neutral-600); line-height: 1.6;">
            You can't see patterns across your reading. Theoretical frameworks stay fuzzy. Synthesis feels impossible.
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Solution Section -->
  <div style="padding: 5rem 1.5rem; background: var(--background);">
    <div style="max-width: 1200px; margin: 0 auto;">
      <div style="text-align: center; margin-bottom: 4rem;">
        <h2 style="font-family: var(--font-display); font-size: 2.5rem; font-weight: 700; color: var(--neutral-900); margin-bottom: 1rem; letter-spacing: -0.02em;">
          Think in networks, not notebooks
        </h2>
        <p style="font-family: var(--font-body); font-size: 1.125rem; color: var(--neutral-600); max-width: 700px; margin: 0 auto; line-height: 1.6;">
          Map My Research is built around how research actually works: concepts connect to sources, which connect to people, which connect to other concepts.
        </p>
      </div>

      <!-- Feature Grid -->
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 3rem;">
        <!-- Feature 1: Concepts -->
        <div>
          <div style="width: 56px; height: 56px; background: var(--accent-green-light); border-radius: 8px; display: flex; align-items: center; justify-content: center; margin-bottom: 1.5rem;">
            <i class="fas fa-lightbulb" style="color: var(--accent-green); font-size: 1.75rem;"></i>
          </div>
          <h3 style="font-family: var(--font-display); font-size: var(--text-xl); font-weight: 700; color: var(--neutral-900); margin-bottom: 1rem;">
            Build concept networks
          </h3>
          <p style="font-family: var(--font-body); font-size: var(--text-base); color: var(--neutral-700); line-height: 1.7; margin-bottom: 1rem;">
            Create constructs like "Grounded Theory" or "Attachment Theory." Connect them hierarchically. See how concepts relate to each other—not just alphabetically, but conceptually.
          </p>
          <div style="background: white; padding: 1rem; border-radius: 4px; border-left: 3px solid var(--accent-green);">
            <code style="font-family: monospace; font-size: var(--text-sm); color: var(--neutral-700);">
              Qualitative Methods → Grounded Theory → Open Coding
            </code>
          </div>
        </div>

        <!-- Feature 2: Sources -->
        <div>
          <div style="width: 56px; height: 56px; background: var(--accent-blue-light); border-radius: 8px; display: flex; align-items: center; justify-content: center; margin-bottom: 1.5rem;">
            <i class="fas fa-book" style="color: var(--accent-blue); font-size: 1.75rem;"></i>
          </div>
          <h3 style="font-family: var(--font-display); font-size: var(--text-xl); font-weight: 700; color: var(--neutral-900); margin-bottom: 1rem;">
            Tag sources semantically
          </h3>
          <p style="font-family: var(--font-body); font-size: var(--text-base); color: var(--neutral-700); line-height: 1.7; margin-bottom: 1rem;">
            Link papers to concepts, people, and tags. Upload PDFs. Take inline notes. Filter by year, author, or theoretical framework. Actually find what you're looking for.
          </p>
          <div style="background: white; padding: 1rem; border-radius: 4px; display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center;">
            <span style="background: var(--accent-green-light); color: var(--accent-green); padding: 0.25rem 0.75rem; border-radius: 4px; font-size: var(--text-xs); font-weight: 500;">Grounded Theory</span>
            <span style="background: var(--accent-gold-light); color: var(--accent-gold); padding: 0.25rem 0.75rem; border-radius: 4px; font-size: var(--text-xs); font-weight: 500;">Strauss</span>
            <span style="background: var(--accent-purple-light); color: var(--accent-purple); padding: 0.25rem 0.75rem; border-radius: 4px; font-size: var(--text-xs); font-weight: 500;">methodology</span>
          </div>
        </div>

        <!-- Feature 3: Notes -->
        <div>
          <div style="width: 56px; height: 56px; background: #e0f2f4; border-radius: 8px; display: flex; align-items: center; justify-content: center; margin-bottom: 1.5rem;">
            <i class="fas fa-sticky-note" style="color: #639CA1; font-size: 1.75rem;"></i>
          </div>
          <h3 style="font-family: var(--font-display); font-size: var(--text-xl); font-weight: 700; color: var(--neutral-900); margin-bottom: 1rem;">
            Notes that connect everything
          </h3>
          <p style="font-family: var(--font-body); font-size: var(--text-base); color: var(--neutral-700); line-height: 1.7; margin-bottom: 1rem;">
            Every note links to sources, concepts, and people. Filter by any combination. Your literature review writes itself when you can see all notes about a concept across all sources.
          </p>
          <div style="background: white; padding: 1rem; border-radius: 4px; border-left: 3px solid #639CA1;">
            <p style="font-family: var(--font-body); font-size: var(--text-sm); color: var(--neutral-700); font-style: italic; margin: 0;">
              "The constant comparison method requires..." → linked to 3 concepts, 2 sources, 1 person
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- How it Works -->
  <div style="padding: 5rem 1.5rem; background: white;">
    <div style="max-width: 900px; margin: 0 auto;">
      <div style="text-align: center; margin-bottom: 3rem;">
        <h2 style="font-family: var(--font-display); font-size: 2.5rem; font-weight: 700; color: var(--neutral-900); margin-bottom: 1rem; letter-spacing: -0.02em;">
          From chaos to clarity in three steps
        </h2>
      </div>

      <div style="display: flex; flex-direction: column; gap: 2rem;">
        <!-- Step 1 -->
        <div style="display: flex; gap: 2rem; align-items: start;">
          <div style="flex-shrink: 0; width: 48px; height: 48px; background: var(--primary); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-family: var(--font-display); font-size: var(--text-xl); font-weight: 700;">
            1
          </div>
          <div style="flex: 1;">
            <h3 style="font-family: var(--font-display); font-size: var(--text-xl); font-weight: 600; color: var(--neutral-900); margin-bottom: 0.5rem;">
              Build your theoretical framework
            </h3>
            <p style="font-family: var(--font-body); font-size: var(--text-base); color: var(--neutral-700); line-height: 1.7;">
              Create concepts for theories, methods, or ideas you're working with. Organize them hierarchically. Define relationships between them.
            </p>
          </div>
        </div>

        <!-- Step 2 -->
        <div style="display: flex; gap: 2rem; align-items: start;">
          <div style="flex-shrink: 0; width: 48px; height: 48px; background: var(--primary); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-family: var(--font-display); font-size: var(--text-xl); font-weight: 700;">
            2
          </div>
          <div style="flex: 1;">
            <h3 style="font-family: var(--font-display); font-size: var(--text-xl); font-weight: 600; color: var(--neutral-900); margin-bottom: 0.5rem;">
              Add sources and connect them
            </h3>
            <p style="font-family: var(--font-body); font-size: var(--text-base); color: var(--neutral-700); line-height: 1.7;">
              Import papers, books, articles. Tag them with concepts. Link to authors. Upload PDFs for inline annotation. Let the system remember what's where.
            </p>
          </div>
        </div>

        <!-- Step 3 -->
        <div style="display: flex; gap: 2rem; align-items: start;">
          <div style="flex-shrink: 0; width: 48px; height: 48px; background: var(--primary); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-family: var(--font-display); font-size: var(--text-xl); font-weight: 700;">
            3
          </div>
          <div style="flex: 1;">
            <h3 style="font-family: var(--font-display); font-size: var(--text-xl); font-weight: 600; color: var(--neutral-900); margin-bottom: 0.5rem;">
              Filter, find, synthesize
            </h3>
            <p style="font-family: var(--font-body); font-size: var(--text-base); color: var(--neutral-700); line-height: 1.7;">
              Need all notes on "Attachment Theory" from sources published after 2015? Done. Want to see how Strauss connects to contemporary researchers? Easy. Your knowledge network is finally searchable.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Who it's for -->
  <div style="padding: 5rem 1.5rem; background: linear-gradient(135deg, #2d5466 0%, #1e3a47 100%); color: white;">
    <div style="max-width: 1200px; margin: 0 auto; text-align: center;">
      <h2 style="font-family: var(--font-display); font-size: 2.5rem; font-weight: 700; margin-bottom: 1rem; letter-spacing: -0.02em;">
        Built for serious knowledge work
      </h2>
      <p style="font-family: var(--font-body); font-size: 1.125rem; line-height: 1.6; color: rgba(255, 255, 255, 0.9); max-width: 700px; margin: 0 auto 3rem;">
        If you're doing research, writing a dissertation, building a framework, or synthesizing complex information—this is for you.
      </p>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 2rem; text-align: left;">
        <div style="background: rgba(255, 255, 255, 0.1); padding: 2rem; border-radius: 4px;">
          <i class="fas fa-graduation-cap" style="font-size: 2rem; margin-bottom: 1rem; color: var(--accent-green-light);"></i>
          <h3 style="font-family: var(--font-display); font-size: var(--text-lg); font-weight: 600; margin-bottom: 0.75rem;">
            PhD Students
          </h3>
          <p style="font-family: var(--font-body); font-size: var(--text-sm); line-height: 1.6; color: rgba(255, 255, 255, 0.85);">
            Managing a literature review across 100+ papers? Building a theoretical framework for your dissertation? Stay organized from day one.
          </p>
        </div>

        <div style="background: rgba(255, 255, 255, 0.1); padding: 2rem; border-radius: 4px;">
          <i class="fas fa-microscope" style="font-size: 2rem; margin-bottom: 1rem; color: var(--accent-blue-light);"></i>
          <h3 style="font-family: var(--font-display); font-size: var(--text-lg); font-weight: 600; margin-bottom: 0.75rem;">
            Researchers
          </h3>
          <p style="font-family: var(--font-body); font-size: var(--text-sm); line-height: 1.6; color: rgba(255, 255, 255, 0.85);">
            Track methodological approaches across studies. Compare theoretical perspectives. Build cumulative knowledge instead of starting from scratch each project.
          </p>
        </div>

        <div style="background: rgba(255, 255, 255, 0.1); padding: 2rem; border-radius: 4px;">
          <i class="fas fa-chalkboard-teacher" style="font-size: 2rem; margin-bottom: 1rem; color: var(--accent-gold-light);"></i>
          <h3 style="font-family: var(--font-display); font-size: var(--text-lg); font-weight: 600; margin-bottom: 0.75rem;">
            Educators & Clinicians
          </h3>
          <p style="font-family: var(--font-body); font-size: var(--text-sm); line-height: 1.6; color: rgba(255, 255, 255, 0.85);">
            Synthesize approaches across modalities. Track evidence for different interventions. Build your personal knowledge base of what works.
          </p>
        </div>

        <div style="background: rgba(255, 255, 255, 0.1); padding: 2rem; border-radius: 4px;">
          <i class="fas fa-brain" style="font-size: 2rem; margin-bottom: 1rem; color: var(--accent-purple-light);"></i>
          <h3 style="font-family: var(--font-display); font-size: var(--text-lg); font-weight: 600; margin-bottom: 0.75rem;">
            Lifelong Learners
          </h3>
          <p style="font-family: var(--font-body); font-size: var(--text-sm); line-height: 1.6; color: rgba(255, 255, 255, 0.85);">
            Building expertise in a complex field? Create your own curriculum. Track your intellectual development. See connections emerge over time.
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Final CTA -->
  <div style="padding: 5rem 1.5rem; background: white;">
    <div style="max-width: 800px; margin: 0 auto; text-align: center;">
      <h2 style="font-family: var(--font-display); font-size: 2.5rem; font-weight: 700; color: var(--neutral-900); margin-bottom: 1rem; letter-spacing: -0.02em;">
        Stop collecting notes.<br>Start building knowledge.
      </h2>
      <p style="font-family: var(--font-body); font-size: 1.125rem; color: var(--neutral-600); line-height: 1.6; margin-bottom: 2.5rem;">
        Your research deserves better than scattered documents and forgotten highlights.
      </p>
      <% if user_signed_in? %>
        <%= link_to dashboard_path, style: "background: var(--primary); color: white; padding: 1rem 3rem; border-radius: 4px; font-family: var(--font-display); font-size: var(--text-lg); font-weight: 600; text-decoration: none; transition: all 0.15s; display: inline-flex; align-items: center; box-shadow: var(--shadow-lg);" do %>
          Go to Dashboard <i class="fas fa-arrow-right" style="margin-left: 0.75rem;"></i>
        <% end %>
      <% else %>
        <%= link_to new_user_registration_path, style: "background: var(--primary); color: white; padding: 1rem 3rem; border-radius: 4px; font-family: var(--font-display); font-size: var(--text-lg); font-weight: 600; text-decoration: none; transition: all 0.15s; display: inline-flex; align-items: center; box-shadow: var(--shadow-lg);" do %>
          Get Started Free <i class="fas fa-arrow-right" style="margin-left: 0.75rem;"></i>
        <% end %>
        <div style="margin-top: 1rem;">
          <p style="font-family: var(--font-body); font-size: var(--text-sm); color: var(--neutral-500);">
            Already have an account? <%= link_to "Sign in", new_user_session_path, style: "color: var(--primary); text-decoration: none; font-weight: 500;" %>
          </p>
        </div>
      <% end %>
    </div>
  </div>
</div>

<style>
  /* Hover states for CTAs */
  a[href*="registration"]:hover,
  a[href*="dashboard"]:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-xl) !important;
  }

  a[href*="session"][style*="transparent"]:hover {
    background: rgba(255, 255, 255, 0.15) !important;
    border-color: rgba(255, 255, 255, 0.8) !important;
  }
</style>
