<script>
  (function() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const hero = document.querySelector('.home-hero');
    if (!hero) return;

    const cards = hero.querySelectorAll('.home-hero-card');
    if (!cards.length) return;

    const factors = new Map();
    cards.forEach(card => {
      let f = 0.05;
      if (card.classList.contains('home-hero-card-concept')) f = 0.09;
      else if (card.classList.contains('home-hero-card-source')) f = 0.06;
      else if (card.classList.contains('home-hero-card-person')) f = 0.03;
      factors.set(card, f);
    });

    let raf = null;
    let isInView = true;

    const update = () => {
      raf = null;
      if (!isInView) return;
      const scroll = -hero.getBoundingClientRect().top;
      cards.forEach(card => {
        const ty = -scroll * factors.get(card);
        card.style.setProperty('--parallax-y', ty.toFixed(1) + 'px');
      });
    };

    const onScroll = () => {
      if (raf === null) raf = requestAnimationFrame(update);
    };

    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(([entry]) => {
        isInView = entry.isIntersecting;
        if (isInView) onScroll();
      }, { threshold: 0 });
      io.observe(hero);
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    update();
  })();

  // ===== Concept-map demo: pan, zoom, hover highlight =====
  (function() {
    const canvas = document.querySelector('.home-demo-canvas[data-interactive]');
    if (!canvas) return;
    const svg = canvas.querySelector('.home-demo-svg');
    const viewport = svg && svg.querySelector('.home-demo-viewport');
    if (!svg || !viewport) return;

    let scale = 1, tx = 0, ty = 0;
    const minScale = 0.6, maxScale = 2.5;

    const apply = () => {
      viewport.setAttribute('transform', `translate(${tx} ${ty}) scale(${scale})`);
    };

    // ---- Pan via drag ----
    let dragging = false, didDrag = false, lastX = 0, lastY = 0;

    const screenToVB = (dx, dy) => {
      const rect = svg.getBoundingClientRect();
      const vb = svg.viewBox.baseVal;
      return {
        x: (dx / rect.width)  * vb.width,
        y: (dy / rect.height) * vb.height
      };
    };

    svg.addEventListener('pointerdown', e => {
      if (e.target.closest('[data-id]')) return;
      dragging = true;
      didDrag = false;
      lastX = e.clientX;
      lastY = e.clientY;
      svg.classList.add('is-dragging');
      try { svg.setPointerCapture(e.pointerId); } catch (_) {}
    });

    svg.addEventListener('pointermove', e => {
      if (!dragging) return;
      const dx = e.clientX - lastX;
      const dy = e.clientY - lastY;
      if (Math.abs(dx) + Math.abs(dy) > 2) didDrag = true;
      lastX = e.clientX;
      lastY = e.clientY;
      const v = screenToVB(dx, dy);
      tx += v.x;
      ty += v.y;
      apply();
    });

    const endDrag = (e) => {
      if (!dragging) return;
      dragging = false;
      svg.classList.remove('is-dragging');
      if (e && e.pointerId !== undefined) {
        try { svg.releasePointerCapture(e.pointerId); } catch (_) {}
      }
    };
    svg.addEventListener('pointerup', endDrag);
    svg.addEventListener('pointercancel', endDrag);
    svg.addEventListener('pointerleave', endDrag);

    // ---- Zoom via buttons ----
    canvas.querySelectorAll('[data-action]').forEach(btn => {
      btn.addEventListener('click', () => {
        const action = btn.dataset.action;
        if (action === 'zoom-in')       scale = Math.min(scale * 1.25, maxScale);
        else if (action === 'zoom-out') scale = Math.max(scale / 1.25, minScale);
        else if (action === 'reset')    { scale = 1; tx = 0; ty = 0; }
        apply();
      });
    });

    // ---- Hover + click highlight ----
    const nodes = Array.from(svg.querySelectorAll('[data-id]'));
    const edges = Array.from(svg.querySelectorAll('[data-from]'));

    let pinnedId = null;
    let hoverId = null;

    const clearStates = () => {
      nodes.forEach(n => n.classList.remove('is-active', 'is-dimmed'));
      edges.forEach(e => e.classList.remove('is-active', 'is-dimmed'));
    };

    const applyHighlight = (id) => {
      clearStates();
      if (!id) return;
      const connected = new Set([id]);
      edges.forEach(edge => {
        if (edge.dataset.from === id) connected.add(edge.dataset.to);
        if (edge.dataset.to === id)   connected.add(edge.dataset.from);
      });
      nodes.forEach(n => {
        if (connected.has(n.dataset.id)) n.classList.add('is-active');
        else n.classList.add('is-dimmed');
      });
      edges.forEach(edge => {
        if (edge.dataset.from === id || edge.dataset.to === id) edge.classList.add('is-active');
        else edge.classList.add('is-dimmed');
      });
    };

    const refresh = () => applyHighlight(pinnedId || hoverId);

    nodes.forEach(node => {
      node.addEventListener('mouseenter', () => {
        hoverId = node.dataset.id;
        refresh();
      });
      node.addEventListener('mouseleave', () => {
        hoverId = null;
        refresh();
      });
      node.addEventListener('click', e => {
        e.stopPropagation();
        const id = node.dataset.id;
        pinnedId = (pinnedId === id) ? null : id;
        refresh();
      });
    });

    svg.addEventListener('click', () => {
      if (didDrag) { didDrag = false; return; }
      pinnedId = null;
      refresh();
    });
  })();
</script>
