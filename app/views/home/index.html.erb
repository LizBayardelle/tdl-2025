    justify-content: center;
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
  }
  .home-import-card-headinfo {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
    flex: 1;
  }
  .home-import-card-name {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--ink);
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .home-import-card-status {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-body);
    font-size: 12px;
    color: var(--person-2);
    font-weight: 500;
  }
  .home-import-card-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--person);
    box-shadow: 0 0 0 3px rgba(31, 163, 163, 0.15);
  }
  .home-import-card-section {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .home-import-card-label {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-body);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .home-import-card-pip {
    width: 6px;
    height: 6px;
    border-radius: 50%;
  }
  .home-import-pip-person  { background: var(--person); }
  .home-import-pip-concept { background: var(--concept); }
  .home-import-pip-source  { background: var(--source); }
  .home-import-card-rows {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .home-import-row-tag {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-body);
    font-size: 12.5px;
    font-weight: 500;
    padding: 4px 10px;
    border-radius: var(--r-pill);
    letter-spacing: 0.005em;
  }
  .home-import-row-tag-person {
    background: var(--person-tint);
    color: var(--person-2);
  }
  .home-import-row-tag-concept {
    background: var(--concept-tint);
    color: var(--concept-2);
  }
  .home-import-notes {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .home-import-note {
    display: flex;
    gap: 12px;
    align-items: baseline;
    padding: 8px 12px;
    background: var(--paper-soft);
    border: 1px solid var(--ink-line);
    border-left: 2px solid var(--source);
    border-radius: var(--r-sm);
    font-family: var(--font-body);
  }
  .home-import-note-page {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--source-2);
    font-weight: 600;
    letter-spacing: 0.04em;
  }
  .home-import-note-text {
    font-size: 13px;
    color: var(--ink-2);
    font-style: italic;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    min-width: 0;
  }

  /* ===== Ask your library ===== */
  .home-ask-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    align-items: stretch;
  }
  .home-ask-card {
    position: relative;
    background: var(--paper);
    border: 1px solid var(--ink-line);
    border-top-width: 3px;
    border-top-color: var(--ink-line);
    border-radius: var(--r-md);
    padding: 28px 26px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    transition: transform 240ms ease, box-shadow 240ms ease;
  }
  .home-ask-card::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--r-md);
    pointer-events: none;
    opacity: 0;
    transition: opacity 240ms ease;
  }
  .home-ask-card-concept { border-top-color: var(--concept); }
  .home-ask-card-source  { border-top-color: var(--source); }
  .home-ask-card-person  { border-top-color: var(--person); }
  .home-ask-card-concept::after { box-shadow: 0 14px 36px rgba(31, 59, 115, 0.10); }
  .home-ask-card-source::after  { box-shadow: 0 14px 36px rgba(47, 128, 237, 0.12); }
  .home-ask-card-person::after  { box-shadow: 0 14px 36px rgba(31, 163, 163, 0.12); }
  .home-ask-card:hover { transform: translateY(-3px); }
  .home-ask-card:hover::after { opacity: 1; }

  .home-ask-q {
    font-family: var(--font-display);
    font-size: 18px;
    font-style: italic;
    font-weight: 500;
    color: var(--ink);
    line-height: 1.4;
    margin: 0;
    text-wrap: pretty;
  }
  .home-ask-divider {
    height: 1px;
    background: var(--ink-line);
    margin: 0 -2px;
  }
  .home-ask-a-label {
    font-family: var(--font-body);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .home-ask-card-concept .home-ask-a-label { color: var(--concept); }
  .home-ask-card-source  .home-ask-a-label { color: var(--source); }
  .home-ask-card-person  .home-ask-a-label { color: var(--person); }

  .home-ask-a-stats {
    list-style: none;
    margin: 0 0 auto;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .home-ask-a-stats li {
    font-family: var(--font-body);
    font-size: 14.5px;
    color: var(--ink-2);
    line-height: 1.4;
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  .home-ask-num {
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 600;
    color: var(--ink);
    letter-spacing: -0.01em;
    font-variant-numeric: tabular-nums;
    min-width: 36px;
    line-height: 1;
  }
  .home-ask-card-concept .home-ask-num { color: var(--concept); }
  .home-ask-card-source  .home-ask-num { color: var(--source); }
  .home-ask-card-person  .home-ask-num { color: var(--person); }

  .home-ask-a-rank {
    list-style: none;
    margin: 0 0 auto;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    counter-reset: rank;
  }
  .home-ask-a-rank li {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-body);
    font-size: 14.5px;
    color: var(--ink);
    counter-increment: rank;
  }
  .home-ask-a-rank li::before {
    content: counter(rank);
    flex-shrink: 0;
    width: 18px;
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 600;
    color: var(--ink-4);
    font-variant-numeric: tabular-nums;
  }
  .home-ask-rank-name {
    flex: 1;
    text-wrap: pretty;
  }
  .home-ask-rank-count {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--person-2);
    font-weight: 600;
    background: var(--person-tint);
    padding: 3px 9px;
    border-radius: var(--r-pill);
    letter-spacing: 0.02em;
    font-variant-numeric: tabular-nums;
    min-width: 28px;
    text-align: center;
  }

  /* ===== Visual demo ===== */
  .home-demo-frame {
    background: var(--paper);
    border: 1px solid var(--ink-line);
    border-radius: var(--r-md);
    overflow: hidden;
    box-shadow:
      0 1px 2px rgba(21, 25, 31, 0.04),
      0 16px 40px rgba(21, 25, 31, 0.08);
  }
  .home-demo-chrome {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    background: var(--paper-soft);
    border-bottom: 1px solid var(--ink-line);
  }
  .home-demo-chrome-dots {
    display: inline-flex;
    gap: 6px;
    flex-shrink: 0;
  }
  .home-demo-chrome-dots span {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--ink-line);
  }
  .home-demo-chrome-dots span:nth-child(1) { background: #FF5F57; }
  .home-demo-chrome-dots span:nth-child(2) { background: #FEBC2E; }
  .home-demo-chrome-dots span:nth-child(3) { background: #28C840; }
  .home-demo-chrome-url {
    flex: 0 1 420px;
    margin: 0 auto;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--ink-3);
    background: var(--paper);
    border: 1px solid var(--ink-line);
    border-radius: var(--r-sm);
    padding: 4px 10px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .home-demo-chrome-spacer {
    width: 50px;
    flex-shrink: 0;
  }
  .home-demo-canvas {
    position: relative;
    background: var(--paper);
    padding: 32px 24px 24px;
  }
  .home-demo-svg {
    width: 100%;
    height: auto;
    display: block;
    cursor: grab;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
  }
  .home-demo-svg.is-dragging { cursor: grabbing; }
  .home-demo-bg {
    fill: transparent;
    pointer-events: all;
  }
  .home-demo-edge {
    stroke: var(--ink-line);
    stroke-width: 1;
    transition: opacity 200ms ease, stroke 200ms ease, stroke-width 200ms ease;
  }
  .home-demo-edge-faint { stroke: var(--ink-line-soft); }
  .home-demo-node {
    cursor: pointer;
  }
  .home-demo-node circle {
    fill: var(--ink-3);
    transition: opacity 200ms ease, r 200ms ease;
  }
  .home-demo-node text {
    font-family: var(--font-body);
    font-size: 12px;
    fill: var(--ink-2);
    transition: opacity 200ms ease, fill 200ms ease;
    paint-order: stroke fill;
    stroke: var(--paper);
    stroke-width: 3;
    stroke-linejoin: round;
  }
  .home-demo-node.is-concept circle { fill: var(--concept); }
  .home-demo-node.is-source  circle { fill: var(--source); }
  .home-demo-node.is-person  circle { fill: var(--person); }
  .home-demo-center circle { fill: var(--ink); }
  .home-demo-center text {
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 600;
    fill: var(--paper);
    stroke: none;
  }

  /* Interaction states */
  .home-demo-node.is-dimmed circle,
  .home-demo-node.is-dimmed text {
    opacity: 0.18;
  }
  .home-demo-edge.is-dimmed { opacity: 0.12; }
  .home-demo-node.is-active text {
    fill: var(--ink);
    font-weight: 600;
  }
  .home-demo-node.is-active circle {
    filter: drop-shadow(0 0 0.5px var(--ink)) drop-shadow(0 1px 4px rgba(21, 25, 31, 0.18));
  }
  .home-demo-edge.is-active {
    stroke: var(--ink-2);
    stroke-width: 1.5;
    opacity: 1;
  }
  .home-demo-edge.is-active.home-demo-edge-faint { stroke: var(--ink-3); }

  /* Controls overlay */
  .home-demo-controls {
    position: absolute;
    top: 44px;
    right: 36px;
    display: flex;
    flex-direction: column;
    background: var(--paper);
    border: 1px solid var(--ink-line);
    border-radius: var(--r-sm);
    box-shadow: 0 1px 3px rgba(21, 25, 31, 0.06);
    z-index: 2;
    overflow: hidden;
  }
  .home-demo-control {
    width: 32px;
    height: 32px;
    background: transparent;
    border: 0;
    padding: 0;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--ink-3);
    transition: background 150ms ease, color 150ms ease;
  }
  .home-demo-control:hover {
    background: var(--hover);
    color: var(--ink);
  }
  .home-demo-control + .home-demo-control {
    border-top: 1px solid var(--ink-line);
  }

  /* Legend + hint */
  .home-demo-legend {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 24px;
    margin-top: 16px;
    flex-wrap: wrap;
  }
  .home-demo-key {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-body);
    font-size: 12.5px;
    color: var(--ink-3);
  }
  .home-demo-key span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--ink-3);
  }
  .home-demo-key.is-concept span { background: var(--concept); }
  .home-demo-key.is-source  span { background: var(--source); }
  .home-demo-key.is-person  span { background: var(--person); }
  .home-demo-hint {
    font-family: var(--font-body);
    font-size: 12px;
    color: var(--ink-4);
    font-style: italic;
    margin-left: auto;
  }
  @media (max-width: 700px) {
    .home-demo-hint { margin-left: 0; }
    .home-demo-controls { top: 28px; right: 20px; }
  }

  /* ===== How it works ===== */
  .home-steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .home-step {
    display: flex;
    gap: 24px;
    padding: 28px 0;
    border-top: 1px solid var(--ink-line);
  }
  .home-step:last-child { border-bottom: 1px solid var(--ink-line); }
  .home-step-n {
    flex-shrink: 0;
    width: 44px;
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 600;
    color: var(--ink-4);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
    padding-top: 4px;
  }
  .home-step-title {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 600;
    color: var(--ink);
    letter-spacing: -0.01em;
    margin: 0 0 6px;
    line-height: 1.2;
  }
  .home-step-text {
    font-family: var(--font-body);
    font-size: 15px;
    color: var(--ink-2);
    line-height: 1.65;
    margin: 0;
    text-wrap: pretty;
  }

  /* ===== Audience ===== */
  .home-audience-grid-primary {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-bottom: 56px;
  }
  .home-audience-card {
    position: relative;
    background: var(--paper);
    border: 1px solid var(--ink-line);
    border-top-width: 3px;
    border-top-color: var(--ink-line);
    border-radius: var(--r-md);
    padding: 26px 24px 22px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    transition: transform 240ms ease, box-shadow 240ms ease;
  }
  .home-audience-card::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--r-md);
    pointer-events: none;
    opacity: 0;
    transition: opacity 240ms ease;
  }
  .home-audience-card:hover { transform: translateY(-3px); }
  .home-audience-card:hover::after { opacity: 1; }
  .home-audience-source  { border-top-color: var(--source); }
  .home-audience-person  { border-top-color: var(--person); }
  .home-audience-concept { border-top-color: var(--concept); }
  .home-audience-source::after  { box-shadow: 0 14px 36px rgba(47, 128, 237, 0.12); }
  .home-audience-person::after  { box-shadow: 0 14px 36px rgba(31, 163, 163, 0.12); }
  .home-audience-concept::after { box-shadow: 0 14px 36px rgba(31, 59, 115, 0.10); }

  .home-audience-icon {
    width: 36px;
    height: 36px;
    border-radius: var(--r-sm);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .home-audience-source  .home-audience-icon { background: var(--source-tint);  color: var(--source-2); }
  .home-audience-person  .home-audience-icon { background: var(--person-tint);  color: var(--person-2); }
  .home-audience-concept .home-audience-icon { background: var(--concept-tint); color: var(--concept-2); }

  .home-audience-eyebrow {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-top: -2px;
  }
  .home-audience-source  .home-audience-eyebrow { color: var(--source); }
  .home-audience-person  .home-audience-eyebrow { color: var(--person); }
  .home-audience-concept .home-audience-eyebrow { color: var(--concept); }

  .home-audience-title {
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 600;
    color: var(--ink);
    margin: 0;
    letter-spacing: -0.008em;
    line-height: 1.25;
    text-wrap: balance;
  }
  .home-audience-text {
    font-family: var(--font-body);
    font-size: 14.5px;
    color: var(--ink-2);
    line-height: 1.6;
    margin: 0;
    text-wrap: pretty;
  }
  .home-audience-query {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 13.5px;
    line-height: 1.45;
    padding: 10px 14px;
    border-radius: 0 var(--r-sm) var(--r-sm) 0;
    border-left: 2px solid;
    margin: auto 0 0;
    text-wrap: pretty;
  }
  .home-audience-source  .home-audience-query { border-left-color: var(--source);  background: var(--source-tint);  color: var(--source-2); }
  .home-audience-person  .home-audience-query { border-left-color: var(--person);  background: var(--person-tint);  color: var(--person-2); }
  .home-audience-concept .home-audience-query { border-left-color: var(--concept); background: var(--concept-tint); color: var(--concept-2); }

  /* Secondary tier (students) */
  .home-audience-students {
    text-align: center;
  }
  .home-audience-students-head {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin: 0 0 20px;
    position: relative;
    padding: 0 16px;
  }
  .home-audience-students-head::before,
  .home-audience-students-head::after {
    content: '';
    position: absolute;
    top: 50%;
    width: 56px;
    height: 1px;
    background: var(--ink-line);
  }
  .home-audience-students-head::before { right: 100%; }
  .home-audience-students-head::after  { left: 100%; }
  .home-audience-grid-secondary {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    max-width: 720px;
    margin: 0 auto;
    text-align: left;
  }
  .home-audience-mini {
    background: var(--paper-soft);
    border: 1px solid var(--ink-line);
    border-radius: var(--r-md);
    padding: 18px 20px;
  }
  .home-audience-mini-title {
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 600;
    color: var(--ink);
    margin: 0 0 4px;
    letter-spacing: -0.005em;
  }
  .home-audience-mini-text {
    font-family: var(--font-body);
    font-size: 13px;
    color: var(--ink-2);
    line-height: 1.55;
    margin: 0;
    text-wrap: pretty;
  }

  /* "Imports from" strip at the bottom of the import section */
  .home-import-services {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 56px;
    padding-top: 32px;
    border-top: 1px solid var(--ink-line);
  }
  .home-import-services-label {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-right: 4px;
  }
  .home-import-service {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--ink-2);
    background: var(--paper);
    border: 1px solid var(--ink-line);
    padding: 6px 12px;
    border-radius: var(--r-sm);
    font-weight: 500;
    letter-spacing: 0.04em;
  }

  /* ===== Founder note ===== */
  .home-founder {
    background: var(--paper);
  }
  .home-founder-inner {
    max-width: 660px;
    margin: 0 auto;
    padding: 88px 24px;
  }
  .home-founder-eyebrow {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: 28px;
    text-align: center;
  }
  .home-founder-text {
    font-family: var(--font-display);
    font-size: 19px;
    font-style: italic;
    font-weight: 400;
    color: var(--ink);
    line-height: 1.55;
    margin: 0 0 22px;
    text-wrap: pretty;
  }
  .home-founder-text:last-of-type {
    margin-bottom: 32px;
  }
  .home-founder-sign {
    font-family: var(--font-display);
    font-size: 16px;
    color: var(--ink-2);
    text-align: right;
    font-style: italic;
    letter-spacing: 0.005em;
  }

  /* ===== Concept packs ===== */
  .home-packs {
    background: var(--paper-soft);
  }
  .home-packs-slider {
    display: flex;
    gap: 24px;
    overflow-x: auto;
    overflow-y: visible;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scroll-padding: 0;
    padding: 4px 4px 16px;
    margin: 0 -4px;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    scrollbar-color: var(--ink-line) transparent;
  }
  .home-packs-slider::-webkit-scrollbar {
