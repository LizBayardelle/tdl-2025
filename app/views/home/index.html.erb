<div style="background: var(--background);">
  <!-- 1. Hero Section -->
  <div style="position: relative; background: linear-gradient(180deg, #eaede2 0%, #f5f7f0 100%); color: var(--neutral-900); padding: 5rem 1.5rem 4rem; overflow: hidden;">
    <!-- Node-and-edge decorative pattern -->
    <div style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; overflow: hidden; pointer-events: none;">
