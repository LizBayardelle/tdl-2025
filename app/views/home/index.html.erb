<% content_for(:title) { "Map My Research · Cross-reference everything you've read." } %>

<div class="home">
  <!-- ===== Hero ===== -->
  <section class="home-hero">
    <div class="home-hero-bg" aria-hidden="true">
      <span class="home-hero-glow home-hero-glow-a"></span>
      <span class="home-hero-glow home-hero-glow-b"></span>
      <span class="home-hero-glow home-hero-glow-c"></span>
      <span class="home-hero-grid"></span>
      <div class="home-hero-noise">
        <span class="home-hero-thought" style="top: 52%; left: 6%; transform: rotate(-3deg);">Which J. Smith was this again?</span>
        <span class="home-hero-thought" style="top: 52%; right: 4%; transform: rotate(2deg);">Sixteen tabs from a PubMed search.</span>
        <span class="home-hero-thought" style="top: 61%; left: 26%; transform: rotate(-1.5deg);">I remember it was a Tuesday.</span>
        <span class="home-hero-thought" style="top: 61%; right: 28%; transform: rotate(3deg);">Two tags refer to the same thing.</span>
        <span class="home-hero-thought" style="top: 70%; left: 4%; transform: rotate(-2deg);">I have three copies of this PDF.</span>
        <span class="home-hero-thought" style="top: 70%; right: 6%; transform: rotate(1deg);">My Zotero and my notes folder disagree.</span>
        <span class="home-hero-thought" style="top: 79%; left: 30%; transform: rotate(2.5deg);">I'm rebuilding the map I already had.</span>
        <span class="home-hero-thought" style="top: 79%; right: 4%; transform: rotate(-2.5deg);">I recognized this abstract twenty seconds in.</span>
        <span class="home-hero-thought" style="top: 88%; left: 4%; transform: rotate(-2deg);">Why am I pasting the same DOI for the fourth time this month?</span>
        <span class="home-hero-thought" style="top: 88%; right: 4%; transform: rotate(2.5deg);">I read this paper.  I wrote notes.  The notes are somewhere.</span>
        <span class="home-hero-thought" style="top: 96%; left: 32%; transform: rotate(-1deg);">Every note I've ever written on construct validity.</span>
      </div>
    </div>
    <div class="home-hero-inner">
      <div class="home-hero-text">
        <span class="home-hero-pill">
          <span class="home-hero-pill-dot"></span>
          Research preview · Free to begin
        </span>
        <h1 class="home-hero-title">Cross-reference everything you've read.</h1>
        <p class="home-hero-sub">
          A research workspace for cumulative work.  Built for medical and psychological researchers who live in the literature.
        </p>
        <div class="home-hero-actions">
          <% if user_signed_in? %>
            <%= link_to "Go to dashboard", dashboard_path, class: "sp-action sp-action-primary home-action home-action-primary" %>
          <% else %>
            <%= link_to "Get started", new_user_registration_path, class: "sp-action sp-action-primary home-action home-action-primary" %>
            <%= link_to "Sign in", new_user_session_path, class: "sp-action sp-action-secondary home-action home-action-secondary" %>
          <% end %>
        </div>
        <% unless user_signed_in? %>
          <p class="home-hero-meta">No credit card.  Your library will compound.</p>
        <% end %>
      </div>

      <div class="home-hero-visual" aria-hidden="true">
        <div class="home-hero-card home-hero-card-source">
          <div class="home-hero-card-head">
            <span class="home-hero-card-eyebrow">Source</span>
            <span class="home-hero-card-doi">DOI · auto-imported</span>
          </div>
          <div class="home-hero-card-title">Bowlby, J. (1969)</div>
          <div class="home-hero-card-meta">Attachment and Loss · Vol. 1</div>
          <div class="home-hero-card-tags">
            <span class="home-hero-tag home-hero-tag-concept">Attachment Theory</span>
            <span class="home-hero-tag home-hero-tag-concept">Internal Working Models</span>
            <span class="home-hero-tag home-hero-tag-person">M. Ainsworth</span>
          </div>
        </div>
        <div class="home-hero-card home-hero-card-concept">
          <span class="home-hero-card-eyebrow">Concept</span>
          <div class="home-hero-card-title">Internal Working Models</div>
          <div class="home-hero-card-meta">14 sources · 8 people</div>
        </div>
        <div class="home-hero-card home-hero-card-person">
          <span class="home-hero-card-eyebrow">Person</span>
          <div class="home-hero-card-title">Mary Ainsworth</div>
          <div class="home-hero-card-meta">3 sources · 2 concepts</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== Bridge: kicker bar ===== -->
  <section class="home-bridge">
    <div class="home-bridge-inner">
      <p class="home-bridge-text">You're not disorganized.  You don't have the right system.</p>
    </div>
  </section>

  <!-- ===== Drop in your PDFs ===== -->
  <section class="home-import">
    <div class="home-section-inner">
      <div class="home-import-grid">
        <div class="home-import-text">
          <div class="home-eyebrow">Automatic import</div>
          <h2 class="home-section-title">Drop in your PDFs.  We'll do the rest.</h2>
          <p class="home-section-sub">
            Give us your 500 random saved journal articles.  We automate the creation of a cross-referenceable database, and give you one place where every note is searchable and tied to the page it came from.
          </p>
          <ul class="home-import-list">
            <li class="home-import-item">
              <span class="home-import-tick home-import-tick-person" aria-hidden="true"></span>
              <span class="home-import-line"><strong>Authors</strong> are extracted into your People database.</span>
            </li>
            <li class="home-import-item">
              <span class="home-import-tick home-import-tick-concept" aria-hidden="true"></span>
              <span class="home-import-line"><strong>Keywords</strong> are linked to your Concepts: physical entities, pathologies, treatments, or disciplines.</span>
            </li>
            <li class="home-import-item">
              <span class="home-import-tick home-import-tick-source" aria-hidden="true"></span>
              <span class="home-import-line"><strong>The PDF</strong> is stored where every note stays tied to a page number.</span>
            </li>
          </ul>
        </div>

        <div class="home-import-visual" aria-hidden="true">
          <div class="home-import-card">
            <div class="home-import-card-head">
              <span class="home-import-card-icon">PDF</span>
              <div class="home-import-card-headinfo">
                <span class="home-import-card-name">yusuf_2003_ace_inhibitors_chf.pdf</span>
                <span class="home-import-card-status">
                  <span class="home-import-card-dot"></span>
                  Imported · 4.2s
                </span>
              </div>
            </div>

            <div class="home-import-card-section">
              <div class="home-import-card-label">
                <span class="home-import-card-pip home-import-pip-person"></span>
                Authors → People
              </div>
              <div class="home-import-card-rows">
                <span class="home-import-row-tag home-import-row-tag-person">Salim Yusuf</span>
                <span class="home-import-row-tag home-import-row-tag-person">Marc Pfeffer</span>
              </div>
            </div>

            <div class="home-import-card-section">
              <div class="home-import-card-label">
                <span class="home-import-card-pip home-import-pip-concept"></span>
                Keywords → Concepts
              </div>
              <div class="home-import-card-rows">
                <span class="home-import-row-tag home-import-row-tag-concept">Heart Failure</span>
                <span class="home-import-row-tag home-import-row-tag-concept">Left Ventricle</span>
                <span class="home-import-row-tag home-import-row-tag-concept">ACE Inhibitors</span>
                <span class="home-import-row-tag home-import-row-tag-concept">Cardiology</span>
              </div>
            </div>

            <div class="home-import-card-section">
              <div class="home-import-card-label">
                <span class="home-import-card-pip home-import-pip-source"></span>
                Notes · tied to page
              </div>
              <div class="home-import-notes">
