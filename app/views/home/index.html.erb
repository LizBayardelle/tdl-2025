  <!-- ===== How it works ===== -->
  <section class="home-how">
    <div class="home-section-inner home-section-inner-narrow">
      <div class="home-section-head">
        <div class="home-eyebrow">How it works</div>
        <h2 class="home-section-title">Set up in minutes.</h2>
      </div>

      <ol class="home-steps">
        <li class="home-step">
          <span class="home-step-n">01</span>
          <div>
            <h3 class="home-step-title">Import your articles.</h3>
            <p class="home-step-text">
              Drop in one or more PDFs or paste in a DOI and we'll auto-extract the authors, link the keywords to your concepts, and keep every note tied to its page.
            </p>
          </div>
        </li>
        <li class="home-step">
          <span class="home-step-n">02</span>
          <div>
            <h3 class="home-step-title">Summon definitions.</h3>
            <p class="home-step-text">
              Hit "Generate Definition" on any concept and Haiku produces a full encyclopedia entry — summary, history, examples, controversies, clinical relevance, citations — in under a minute.
            </p>
          </div>
        </li>
        <li class="home-step">
          <span class="home-step-n">03</span>
          <div>
            <h3 class="home-step-title">Take notes.</h3>
            <p class="home-step-text">
              Create new notes right from the PDF viewer.  They automatically tie to the page and source you're on, so you can find and organize them without effort.
            </p>
          </div>
        </li>
        <li class="home-step">
          <span class="home-step-n">04</span>
          <div>
            <h3 class="home-step-title">Search, filter, and write.</h3>
            <p class="home-step-text">
              Filter notes by concept, person, or year.  Pull up everything you have ever read about a topic in one view.  The literature review writes itself.
            </p>
          </div>
