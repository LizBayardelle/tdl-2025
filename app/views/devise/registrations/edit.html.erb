<div style="min-height: calc(100vh - 64px); background: var(--background); padding: var(--space-8) var(--space-6);">
  <div style="max-width: 600px; margin: 0 auto;">
    <!-- Header -->
    <div style="margin-bottom: var(--space-8);">
      <h1 style="font-family: var(--font-display); font-size: var(--text-3xl); font-weight: 700; color: var(--neutral-900); letter-spacing: -0.02em; margin-bottom: var(--space-2);">
        Account Settings
      </h1>
      <p style="font-family: var(--font-body); font-size: var(--text-sm); color: var(--neutral-500); margin: 0;">
        Update your email and password
      </p>
    </div>

    <!-- Profile Image Card (separate auto-saving form) -->
    <div class="card" style="margin-bottom: var(--space-6);">
      <div style="padding: var(--space-6);">
        <h2 style="font-family: var(--font-display); font-size: var(--text-lg); font-weight: 600; color: var(--neutral-900); margin-bottom: var(--space-6);">
          Profile Image
        </h2>

        <div style="display: flex; align-items: center; gap: var(--space-6);">
          <!-- Current Image Preview -->
          <div id="profile-image-preview" style="flex-shrink: 0;">
            <% if resource.profile_image.attached? && resource.profile_image.blob.persisted? %>
              <%= image_tag resource.profile_image.variant(resize_to_fill: [96, 96]), style: "width: 96px; height: 96px; border-radius: 50%; object-fit: cover; border: 3px solid var(--neutral-200);", id: "profile-image-img" %>
            <% else %>
              <div id="profile-image-placeholder" style="width: 96px; height: 96px; border-radius: 50%; background: var(--neutral-200); display: flex; align-items: center; justify-content: center; border: 3px solid var(--neutral-300);">
                <i class="fas fa-user" style="font-size: 40px; color: var(--neutral-400);"></i>
              </div>
            <% end %>
          </div>

          <!-- Upload Field -->
          <div style="flex: 1;">
            <label for="profile_image_input" class="form-label" style="display: block; font-family: var(--font-display); font-size: var(--text-sm); font-weight: 500; margin-bottom: var(--space-2); color: var(--neutral-700);">Upload New Image</label>
            <input type="file" id="profile_image_input" name="profile_image" accept="image/*" class="form-input" style="width: 100%; padding: var(--space-2); border: 1px solid var(--neutral-300); border-radius: 4px; font-size: var(--text-sm); font-family: var(--font-body);" />
            <div id="profile-image-status" style="font-size: var(--text-xs); color: var(--neutral-500); margin-top: var(--space-2);">
              JPG, PNG, or GIF. Max 5MB.
            </div>
          </div>
        </div>
      </div>
    </div>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
      <!-- Error Messages -->
      <%= render "devise/shared/error_messages", resource: resource %>

      <!-- Main Settings Card -->
      <div class="card" style="margin-bottom: var(--space-6);">
        <div style="padding: var(--space-6);">
          <h2 style="font-family: var(--font-display); font-size: var(--text-lg); font-weight: 600; color: var(--neutral-900); margin-bottom: var(--space-6);">
            Login Information
          </h2>

          <!-- Email Field -->
          <div style="margin-bottom: var(--space-6);">
            <%= f.label :email, class: "form-label", style: "display: block; font-family: var(--font-display); font-size: var(--text-sm); font-weight: 500; margin-bottom: var(--space-2); color: var(--neutral-700);" %>
            <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-input", style: "width: 100%; padding: var(--space-3); border: 1px solid var(--neutral-300); border-radius: 4px; font-size: var(--text-sm); font-family: var(--font-body); transition: all 0.15s;" %>
            <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
              <div style="font-size: var(--text-xs); color: var(--warning); margin-top: var(--space-2);">
                <i class="fas fa-clock"></i> Waiting for confirmation: <%= resource.unconfirmed_email %>
              </div>
            <% end %>
          </div>

          <!-- Password Section -->
          <div style="margin-bottom: var(--space-6);">
            <%= f.label :password, class: "form-label", style: "display: block; font-family: var(--font-display); font-size: var(--text-sm); font-weight: 500; margin-bottom: var(--space-1); color: var(--neutral-700);" %>
            <div style="font-size: var(--text-xs); color: var(--neutral-500); margin-bottom: var(--space-2);">
              Leave blank if you don't want to change it
            </div>
            <%= f.password_field :password, autocomplete: "new-password", class: "form-input", placeholder: "New password", style: "width: 100%; padding: var(--space-3); border: 1px solid var(--neutral-300); border-radius: 4px; font-size: var(--text-sm); font-family: var(--font-body); transition: all 0.15s;" %>
            <% if @minimum_password_length %>
              <div style="font-size: var(--text-xs); color: var(--neutral-500); margin-top: var(--space-2);">
                <%= @minimum_password_length %> characters minimum
              </div>
            <% end %>
          </div>

          <!-- Password Confirmation -->
          <div style="margin-bottom: var(--space-6);">
            <%= f.label :password_confirmation, "Confirm New Password", class: "form-label", style: "display: block; font-family: var(--font-display); font-size: var(--text-sm); font-weight: 500; margin-bottom: var(--space-2); color: var(--neutral-700);" %>
            <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-input", placeholder: "Confirm new password", style: "width: 100%; padding: var(--space-3); border: 1px solid var(--neutral-300); border-radius: 4px; font-size: var(--text-sm); font-family: var(--font-body); transition: all 0.15s;" %>
          </div>

          <!-- Current Password -->
          <div style="padding-top: var(--space-4); border-top: 1px solid var(--neutral-200);">
            <%= f.label :current_password, class: "form-label required", style: "display: block; font-family: var(--font-display); font-size: var(--text-sm); font-weight: 500; margin-bottom: var(--space-1); color: var(--neutral-700);" %>
            <div style="font-size: var(--text-xs); color: var(--neutral-500); margin-bottom: var(--space-2);">
              We need your current password to confirm your changes
            </div>
            <%= f.password_field :current_password, autocomplete: "current-password", class: "form-input", placeholder: "Current password", style: "width: 100%; padding: var(--space-3); border: 1px solid var(--neutral-300); border-radius: 4px; font-size: var(--text-sm); font-family: var(--font-body); transition: all 0.15s;" %>
          </div>
        </div>

        <!-- Card Footer with Actions -->
        <div style="padding: var(--space-4) var(--space-6); background: var(--card-footer); border-top: 1px solid var(--neutral-200); display: flex; gap: var(--space-3); justify-content: flex-end;">
          <%= link_to "Cancel", :back, style: "background: transparent; color: var(--neutral-700); border: 1px solid var(--neutral-300); padding: var(--space-2) var(--space-4); border-radius: 4px; font-family: var(--font-display); font-size: var(--text-sm); font-weight: 500; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; transition: all 0.15s;" %>
          <%= f.submit "Update Login Information", class: "btn-primary", style: "background: var(--primary); color: white; border: none; padding: var(--space-2) var(--space-4); border-radius: 4px; font-family: var(--font-display); font-size: var(--text-sm); font-weight: 600; cursor: pointer; transition: all 0.15s;" %>
        </div>
      </div>
    <% end %>

    <!-- Delete Account Section -->
    <div class="card" style="border: 1px solid var(--error);">
      <div style="padding: var(--space-6);">
        <h2 style="font-family: var(--font-display); font-size: var(--text-lg); font-weight: 600; color: var(--error); margin-bottom: var(--space-3);">
          <i class="fas fa-exclamation-triangle"></i> Danger Zone
        </h2>
        <p style="font-size: var(--text-sm); color: var(--neutral-600); margin-bottom: var(--space-4); line-height: 1.6;">
          Once you delete your account, there is no going back. This action cannot be undone and will permanently delete all your data.
        </p>
        <%= button_to "Delete My Account", registration_path(resource_name),
          data: { confirm: "Are you absolutely sure? This will permanently delete your account and all associated data. This action cannot be undone." },
          method: :delete,
          style: "background: var(--error); color: white; border: none; padding: var(--space-2) var(--space-4); border-radius: 4px; font-family: var(--font-display); font-size: var(--text-sm); font-weight: 600; cursor: pointer; transition: all 0.15s;" %>
      </div>
    </div>
  </div>
</div>

<style>
  .form-input:focus,
  .form-select:focus,
  .form-textarea:focus {
    outline: none;
    border: 2px solid var(--primary) !important;
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--primary) 10%, transparent);
    padding: calc(var(--space-3) - 1px);
  }

  .btn-primary:hover {
    background: var(--primary-dark) !important;
    transform: translateY(-1px);
    box-shadow: var(--shadow-md);
  }

  .btn-primary:active {
    transform: translateY(0);
  }

  input[type="submit"][style*="var(--error)"]:hover,
  button[style*="var(--error)"]:hover {
    background: #6b1f1f !important;
    transform: translateY(-1px);
    box-shadow: var(--shadow-md);
  }

  a[href]:hover {
    background: var(--neutral-100) !important;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const fileInput = document.getElementById('profile_image_input');
    const preview = document.getElementById('profile-image-preview');
    const status = document.getElementById('profile-image-status');

    if (fileInput) {
      fileInput.addEventListener('change', async function(e) {
        const file = e.target.files[0];
        if (!file) return;

        // Validate file size (5MB max)
        if (file.size > 5 * 1024 * 1024) {
          status.textContent = 'File too large. Max 5MB.';
          status.style.color = 'var(--error)';
          return;
        }

        // Show uploading status
        status.textContent = 'Uploading...';
        status.style.color = 'var(--accent-blue)';

        // Create form data
        const formData = new FormData();
        formData.append('profile_image', file);

        try {
          const response = await fetch('<%= update_profile_image_path %>', {
            method: 'PATCH',
            headers: {
              'X-CSRF-Token': document.querySelector('[name="csrf-token"]').content,
              'Accept': 'application/json'
            },
            body: formData
          });

          const data = await response.json();

          if (data.success) {
            // Update preview
            preview.innerHTML = `<img src="${data.image_url}" style="width: 96px; height: 96px; border-radius: 50%; object-fit: cover; border: 3px solid var(--neutral-200);" id="profile-image-img" />`;
            status.textContent = 'Image updated!';
            status.style.color = 'var(--accent-green)';

            // Also update nav profile image if it exists
            const navImg = document.querySelector('#user-menu-button img');
            if (navImg) {
              navImg.src = data.image_url.replace('96', '32').replace('96', '32');
            }

            // Reset status after a moment
            setTimeout(() => {
              status.textContent = 'JPG, PNG, or GIF. Max 5MB.';
              status.style.color = 'var(--neutral-500)';
            }, 3000);
          } else {
            status.textContent = data.errors?.join(', ') || 'Upload failed.';
            status.style.color = 'var(--error)';
          }
        } catch (error) {
          console.error('Upload error:', error);
          status.textContent = 'Upload failed. Please try again.';
          status.style.color = 'var(--error)';
        }

        // Clear the file input
        fileInput.value = '';
      });
    }
  });
</script>
