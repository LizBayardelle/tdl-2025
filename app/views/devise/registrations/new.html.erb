<% content_for(:title) { "Create an account · Map My Research" } %>

<div class="auth-shell">
  <div class="auth-card">
    <div class="auth-brand">
      <%= link_to root_path, aria: { label: "Map My Research home" } do %>
        <img src="/logo.png" alt="" width="56" height="56" class="auth-logo auth-logo-light">
        <img src="/logo-white.png" alt="" width="56" height="56" class="auth-logo auth-logo-dark">
      <% end %>
    </div>

    <h1 class="auth-title">Create an account</h1>
    <p class="auth-subtitle">Free.  No credit card.</p>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "auth-form" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="sp-field">
        <%= f.label :email, "Email", class: "sp-label" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true, class: "sp-input" %>
      </div>

      <div class="sp-field">
        <%= f.label :password, "Password", class: "sp-label" %>
        <%= f.password_field :password, autocomplete: "new-password", required: true, class: "sp-input" %>
        <% if @minimum_password_length %>
          <div class="sp-help"><%= @minimum_password_length %> characters minimum.</div>
        <% end %>
      </div>

      <div class="sp-field">
        <%= f.label :password_confirmation, "Confirm password", class: "sp-label" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", required: true, class: "sp-input" %>
      </div>

      <%= f.submit "Create account", class: "sp-action sp-action-primary auth-submit" %>
    <% end %>

    <div class="auth-footer">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
