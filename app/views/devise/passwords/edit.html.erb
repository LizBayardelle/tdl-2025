<% content_for(:title) { "Set a new password · Map My Research" } %>

<div class="auth-shell">
  <div class="auth-card">
    <div class="auth-brand">
      <%= link_to root_path, aria: { label: "Map My Research home" } do %>
        <img src="/logo.png" alt="" width="56" height="56" class="auth-logo auth-logo-light">
        <img src="/logo-white.png" alt="" width="56" height="56" class="auth-logo auth-logo-dark">
      <% end %>
    </div>

    <h1 class="auth-title">Set a new password</h1>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "auth-form" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>
      <%= f.hidden_field :reset_password_token %>

      <div class="sp-field">
        <%= f.label :password, "New password", class: "sp-label" %>
        <%= f.password_field :password, autofocus: true, autocomplete: "new-password", required: true, class: "sp-input" %>
        <% if @minimum_password_length %>
          <div class="sp-help"><%= @minimum_password_length %> characters minimum.</div>
        <% end %>
      </div>

      <div class="sp-field">
        <%= f.label :password_confirmation, "Confirm new password", class: "sp-label" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", required: true, class: "sp-input" %>
      </div>

      <%= f.submit "Save new password", class: "sp-action sp-action-primary auth-submit" %>
    <% end %>

    <div class="auth-footer">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
