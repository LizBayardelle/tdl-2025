<div style="font-family: var(--font-body); font-size: var(--text-sm); display: flex; flex-direction: column; gap: 0.75rem;">
  <%- if controller_name != 'sessions' %>
    <div style="color: var(--neutral-600);">
      Already have an account? <%= link_to "Sign in", new_session_path(resource_name), style: "color: var(--primary); text-decoration: none; font-weight: 600; transition: color 0.15s;" %>
    </div>
  <% end %>

  <%- if devise_mapping.registerable? && controller_name != 'registrations' %>
    <div style="color: var(--neutral-600);">
      Don't have an account? <%= link_to "Sign up", new_registration_path(resource_name), style: "color: var(--primary); text-decoration: none; font-weight: 600; transition: color 0.15s;" %>
    </div>
  <% end %>

  <%- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
    <%= link_to "Forgot your password?", new_password_path(resource_name), style: "color: var(--neutral-600); text-decoration: none; font-weight: 500; transition: color 0.15s;" %>
  <% end %>

  <%- if devise_mapping.confirmable? && controller_name != 'confirmations' %>
    <%= link_to "Didn't receive confirmation instructions?", new_confirmation_path(resource_name), style: "color: var(--neutral-600); text-decoration: none; font-weight: 500; transition: color 0.15s;" %>
  <% end %>

  <%- if devise_mapping.lockable? && resource_class.unlock_strategy_enabled?(:email) && controller_name != 'unlocks' %>
    <%= link_to "Didn't receive unlock instructions?", new_unlock_path(resource_name), style: "color: var(--neutral-600); text-decoration: none; font-weight: 500; transition: color 0.15s;" %>
  <% end %>

  <%- if devise_mapping.omniauthable? %>
    <%- resource_class.omniauth_providers.each do |provider| %>
      <%= button_to "Sign in with #{OmniAuth::Utils.camelize(provider)}", omniauth_authorize_path(resource_name, provider), style: "color: var(--primary); text-decoration: none; font-weight: 600; background: none; border: none; cursor: pointer; padding: 0; font-family: var(--font-body); font-size: var(--text-sm); transition: color 0.15s;" %>
    <% end %>
  <% end %>
</div>

<style>
  a[style*="var(--primary)"]:hover {
    color: var(--primary-dark) !important;
  }

  a[style*="var(--neutral-600)"]:hover {
    color: var(--primary) !important;
  }

  button[style*="var(--primary)"]:hover {
    color: var(--primary-dark) !important;
  }
</style>
