<% if resource.errors.any? %>
  <div class="auth-error" role="alert">
    <p class="auth-error-title"><%= pluralize(resource.errors.count, "error") %> below.</p>
    <ul>
      <% resource.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
