<% content_for(:title) { "Sign in · Map My Research" } %>

<div class="auth-shell">
  <div class="auth-card">
    <div class="auth-brand">
      <%= link_to root_path, aria: { label: "Map My Research home" } do %>
        <img src="/logo.png" alt="" width="56" height="56" class="auth-logo auth-logo-light">
        <img src="/logo-white.png" alt="" width="56" height="56" class="auth-logo auth-logo-dark">
      <% end %>
    </div>

    <h1 class="auth-title">Sign in</h1>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "auth-form" }) do |f| %>
      <div class="sp-field">
        <%= f.label :email, "Email", class: "sp-label" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true, class: "sp-input" %>
      </div>

      <div class="sp-field">
        <%= f.label :password, "Password", class: "sp-label" %>
        <%= f.password_field :password, autocomplete: "current-password", required: true, class: "sp-input" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <label class="auth-remember">
          <%= f.check_box :remember_me, class: "sp-checkbox" %>
          <span>Remember me</span>
        </label>
      <% end %>

      <%= f.submit "Sign in", class: "sp-action sp-action-primary auth-submit" %>
    <% end %>

    <div class="auth-footer">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
