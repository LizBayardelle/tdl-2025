<div class="ns-shell">
  <div class="ns-container">
    <div class="ns-back-row">
      <%= link_to "← All notes", notes_path, class: "ns-back" %>
    </div>

    <article class="ns-card">
      <header class="ns-header">
        <div class="ns-header-meta">
          <% if @note.pinned %>
            <span class="ns-pin" title="Pinned">
              <i class="fa-solid fa-thumbtack"></i>
            </span>
          <% end %>
          <span class="ns-type-pill">
            <%= @note.note_type.titleize %>
          </span>
        </div>
        <div class="ns-header-actions">
          <%= link_to "Edit", edit_note_path(@note), class: "sp-action sp-action-secondary" %>
          <%= button_to "Delete",
                note_path(@note),
                method: :delete,
                form: { class: "ns-delete-form" },
                data: { turbo_confirm: "Deleting this note is permanent and cannot be undone." },
                class: "sp-action sp-action-quiet sp-action-danger" %>
        </div>
      </header>

      <% if @note.title.present? %>
        <h1 class="ns-title"><%= @note.title %></h1>
      <% end %>

      <% if @note.concepts.any? %>
        <div class="ns-chip-row">
          <% @note.concepts.each do |concept| %>
            <%= link_to concept.label, concept_path(concept), class: "sp-chip is-concept" %>
          <% end %>
        </div>
      <% end %>

      <div class="ns-body prose prose-lg max-w-none [&_ul]:list-disc [&_ul]:ml-6 [&_ol]:list-decimal [&_ol]:ml-6 [&_li]:ml-2 [&_h1]:text-3xl [&_h1]:font-bold [&_h1]:mt-4 [&_h1]:mb-2 [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:mt-3 [&_h2]:mb-2 [&_h3]:text-xl [&_h3]:font-bold [&_h3]:mt-2 [&_h3]:mb-1 [&_h4]:text-lg [&_h4]:font-bold [&_h4]:mt-2 [&_h4]:mb-1 [&_h5]:text-base [&_h5]:font-bold [&_h5]:mt-2 [&_h5]:mb-1 [&_h6]:text-sm [&_h6]:font-bold [&_h6]:mt-2 [&_h6]:mb-1 [&_pre]:p-4 [&_pre]:rounded [&_pre]:overflow-x-auto [&_table]:border-collapse [&_table]:w-full [&_td]:p-2 [&_th]:p-2">
        <%= @note.body.html_safe %>
      </div>

      <% if @note.context.present? %>
        <aside class="ns-context">
          <div class="ns-context-eyebrow">Context</div>
          <p class="ns-context-body"><%= @note.context %></p>
        </aside>
      <% end %>

      <% if @note.source || @note.people.any? || @note.tags.any? %>
        <section class="ns-related">
          <h2 class="ns-related-title">Related</h2>
          <div class="ns-chip-row">
            <% if @note.source %>
              <%= link_to source_path(@note.source), class: "sp-chip is-source" do %>
                <%= @note.source.title %>
              <% end %>
            <% end %>
            <% @note.people.each do |person| %>
              <%= link_to person_path(person), class: "sp-chip is-person" do %>
                <%= person.full_name %>
              <% end %>
            <% end %>
            <% @note.tags.each do |tag| %>
              <%= link_to tag_path(tag.name), class: "sp-chip is-neutral" do %>
                <%= tag.name %>
              <% end %>
            <% end %>
          </div>
        </section>
      <% end %>

      <footer class="ns-footer">
        <p>Created <%= @note.created_at.strftime("%B %-d, %Y at %-I:%M %p") %></p>
        <% if @note.noted_on && @note.noted_on.to_s != @note.created_at.to_date.to_s %>
          <p>Noted on <%= @note.noted_on.strftime("%B %-d, %Y") %></p>
        <% end %>
        <% if @note.updated_at != @note.created_at %>
          <p>Last updated <%= @note.updated_at.strftime("%B %-d, %Y at %-I:%M %p") %></p>
        <% end %>
      </footer>
    </article>
  </div>
</div>

<style>
  .ns-shell {
    flex: 1;
    background: var(--paper-soft);
    padding: 32px 20px 64px;
  }
  .ns-container {
    max-width: 820px;
    margin: 0 auto;
  }

  .ns-back-row { margin-bottom: 16px; }
  .ns-back {
    font-family: var(--font-body);
    font-size: 12.5px;
    color: var(--ink-3);
    text-decoration: none;
  }
  .ns-back:hover { color: var(--primary); }

  .ns-card {
    background: var(--paper);
    border: 1px solid var(--ink-line);
    border-radius: var(--r-md);
    padding: 32px 36px;
  }

  .ns-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 20px;
    flex-wrap: wrap;
  }
  .ns-header-meta {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .ns-header-actions {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }
  .ns-delete-form {
    display: inline-block;
    margin: 0;
  }

  .ns-pin {
    color: var(--primary);
    font-size: 13px;
  }
  .ns-type-pill {
    font-family: var(--font-body);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
    background: var(--paper-warm);
    padding: 3px 10px;
    border-radius: var(--r-sm);
  }

  .ns-title {
    font-family: var(--font-display);
    font-size: 32px;
    font-weight: 600;
    color: var(--primary);
    letter-spacing: -0.015em;
    line-height: 1.15;
    margin: 0 0 16px;
    text-wrap: balance;
  }

  .ns-chip-row {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 24px;
  }

  .ns-body {
    font-family: var(--font-body);
    font-size: 15px;
    color: var(--ink);
    line-height: 1.75;
    margin: 0 0 24px;
  }
  .ns-body :is(blockquote) {
    border-left: 3px solid var(--ink-line);
    padding-left: 16px;
    color: var(--ink-2);
    font-style: italic;
    margin: 0 0 12px;
  }
  .ns-body :is(code) {
    font-family: var(--font-mono);
    font-size: 12.5px;
    background: var(--paper-warm);
    padding: 1px 5px;
    border-radius: 2px;
  }
  .ns-body :is(pre) {
    background: var(--paper-warm);
    border: 1px solid var(--ink-line-soft);
  }
  .ns-body :is(td, th) {
    border: 1px solid var(--ink-line);
  }

  .ns-context {
    background: var(--paper-soft);
    border: 1px solid var(--ink-line-soft);
    border-left: 3px solid var(--primary);
    border-radius: var(--r-sm);
    padding: 14px 16px;
    margin: 0 0 24px;
  }
  .ns-context-eyebrow {
    font-family: var(--font-body);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: 6px;
  }
  .ns-context-body {
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--ink-2);
    line-height: 1.6;
    margin: 0;
  }

  .ns-related {
    border-top: 1px solid var(--ink-line-soft);
    padding-top: 20px;
    margin-bottom: 20px;
  }
  .ns-related-title {
    font-family: var(--font-body);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin: 0 0 10px;
  }

  .ns-footer {
    border-top: 1px solid var(--ink-line-soft);
    padding-top: 14px;
    font-family: var(--font-body);
    font-size: 12px;
    color: var(--ink-3);
  }
  .ns-footer p { margin: 0 0 2px; }
  .ns-footer p:last-child { margin: 0; }

  @media (max-width: 600px) {
    .ns-card { padding: 22px 20px; }
    .ns-title { font-size: 26px; }
  }
</style>
