<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="mb-6">
    <%= link_to "← Back to Notes", notes_path, class: "text-primary hover:text-accent-dark" %>
  </div>

  <div class="bg-white border border-gray-300 rounded-lg p-8">
    <div class="mb-6">
      <div class="flex items-center justify-between mb-4">
        <div class="flex items-center gap-3">
          <span class="<%= @note.pinned ? 'text-primary' : 'text-sand' %>" title="<%= @note.pinned ? 'Pinned' : 'Not pinned' %>">
            <i class="fa-solid fa-thumbtack"></i>
          </span>
          <span class="text-xs uppercase tracking-wider px-3 py-1 rounded bg-sand text-gray-800 font-medium">
            <%= @note.note_type.titleize %>
          </span>
        </div>
        <div class="flex gap-2">
          <%= link_to "Edit", edit_note_path(@note), class: "px-4 py-2 border border-gray-300 rounded hover:bg-sand transition-colors" %>
          <%= button_to "Delete", note_path(@note), method: :delete, data: { turbo_confirm: "Are you sure?" }, class: "px-4 py-2 text-white bg-accent hover:bg-accent-dark rounded transition-colors" %>
        </div>
      </div>

      <% if @note.title.present? %>
        <h1 class="text-3xl font-bold mb-4"><%= @note.title %></h1>
      <% end %>

      <% if @note.concepts.any? %>
        <div class="mb-4 flex flex-wrap gap-2">
          <% @note.concepts.each do |concept| %>
            <%= link_to concept.label, concept_path(concept), class: "text-xs bg-accent-dark text-sand px-3 py-1 rounded hover:bg-primary transition-colors" %>
          <% end %>
        </div>
      <% end %>
    </div>

    <div class="prose prose-lg max-w-none mb-6 [&_ul]:list-disc [&_ul]:ml-6 [&_ol]:list-decimal [&_ol]:ml-6 [&_li]:ml-2 [&_h1]:text-3xl [&_h1]:font-bold [&_h1]:mt-4 [&_h1]:mb-2 [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:mt-3 [&_h2]:mb-2 [&_h3]:text-xl [&_h3]:font-bold [&_h3]:mt-2 [&_h3]:mb-1 [&_h4]:text-lg [&_h4]:font-bold [&_h4]:mt-2 [&_h4]:mb-1 [&_h5]:text-base [&_h5]:font-bold [&_h5]:mt-2 [&_h5]:mb-1 [&_h6]:text-sm [&_h6]:font-bold [&_h6]:mt-2 [&_h6]:mb-1 [&_blockquote]:border-l-4 [&_blockquote]:border-gray-300 [&_blockquote]:pl-4 [&_blockquote]:italic [&_blockquote]:text-gray-700 [&_pre]:bg-gray-100 [&_pre]:p-4 [&_pre]:rounded [&_pre]:overflow-x-auto [&_code]:bg-gray-100 [&_code]:px-1 [&_code]:rounded [&_table]:border-collapse [&_table]:w-full [&_td]:border [&_td]:border-gray-300 [&_td]:p-2 [&_th]:border [&_th]:border-gray-300 [&_th]:p-2 [&_th]:bg-gray-100">
      <%= @note.body.html_safe %>
    </div>

    <% if @note.context.present? %>
      <div class="bg-sand rounded p-4 mb-6">
        <p class="text-sm font-medium text-gray-700 mb-1">Context</p>
        <p class="text-gray-700"><%= @note.context %></p>
      </div>
    <% end %>

    <% if @note.source || @note.people.any? || @note.tags.any? %>
      <div class="border-t border-gray-200 pt-6 mb-6">
        <h2 class="text-lg font-semibold mb-3">Related Items</h2>
        <div class="flex flex-wrap gap-2">
          <% if @note.source %>
            <%= link_to source_path(@note.source), class: "text-xs bg-accent-dark text-sand px-3 py-1 rounded hover:bg-primary-light transition-colors" do %>
              <%= @note.source.title %>
            <% end %>
          <% end %>
          <% @note.people.each do |person| %>
            <%= link_to person_path(person), class: "text-xs bg-sand text-primary border border-primary px-3 py-1 rounded hover:bg-primary-light transition-colors" do %>
              <%= person.full_name %>
            <% end %>
          <% end %>
          <% @note.tags.each do |tag| %>
            <%= link_to tag_path(tag.name), class: "text-xs bg-primary text-sand px-3 py-1 rounded hover:bg-primary-light transition-colors" do %>
              <%= tag.name %>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>

    <div class="border-t border-gray-200 pt-4 text-sm text-gray-500">
      <p>Created: <%= @note.created_at.strftime("%B %d, %Y at %I:%M %p") %></p>
      <% if @note.noted_on && @note.noted_on.to_s != @note.created_at.to_date.to_s %>
        <p>Noted on: <%= @note.noted_on.strftime("%B %d, %Y") %></p>
      <% end %>
      <% if @note.updated_at != @note.created_at %>
        <p>Last updated: <%= @note.updated_at.strftime("%B %d, %Y at %I:%M %p") %></p>
      <% end %>
    </div>
  </div>
</div>
