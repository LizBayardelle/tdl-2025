<%
  # Active-state helpers
  active = ->(prefix) { request.path.start_with?(prefix) }
  on_dashboard = current_page?(dashboard_path) rescue false
%>

<nav class="site-nav">
  <div class="site-nav-inner">
    <!-- Brand: logo only -->
    <%= link_to root_path, class: "site-nav-brand", aria: { label: "Map My Research home" } do %>
      <img src="/logo.png" alt="Map My Research" class="site-nav-logo site-nav-logo-light" width="40" height="40">
      <img src="/logo-white.png" alt="Map My Research" class="site-nav-logo site-nav-logo-dark" width="40" height="40">
    <% end %>

    <% if user_signed_in? %>
      <!-- Primary nav (desktop) -->
      <div class="site-nav-links">
        <%= link_to dashboard_path, class: "site-nav-link #{'is-active' if on_dashboard}" do %>
          Dashboard
        <% end %>
        <%= link_to concepts_path, class: "site-nav-link #{'is-active' if active.('/concepts')}" do %>
          <span class="site-nav-dot is-concept" aria-hidden="true"></span>
          Concepts
        <% end %>
        <%= link_to sources_path, class: "site-nav-link #{'is-active' if active.('/sources')}" do %>
          <span class="site-nav-dot is-source" aria-hidden="true"></span>
          Sources
        <% end %>
        <%= link_to people_path, class: "site-nav-link #{'is-active' if active.('/people')}" do %>
          <span class="site-nav-dot is-person" aria-hidden="true"></span>
          People
        <% end %>
        <%= link_to notes_path, class: "site-nav-link #{'is-active' if active.('/notes')}" do %>
          Notes
        <% end %>

        <div class="site-nav-tabletops" id="tabletops-menu-wrap">
          <button type="button" id="tabletops-menu-button" class="site-nav-link site-nav-tabletops-trigger <%= 'is-active' if active.('/tabletops') %>" aria-haspopup="menu" aria-expanded="false">
            Tabletops
            <span class="site-nav-caret" aria-hidden="true">
              <svg width="10" height="10" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 5l3 3 3-3" />
              </svg>
            </span>
          </button>
          <div id="tabletops-menu-dropdown" class="site-nav-dropdown site-nav-dropdown-tabletops">
            <%= link_to tabletops_path, class: "site-nav-dropdown-link" do %>
              <i class="fas fa-table-cells-large site-nav-dropdown-icon"></i>All Tabletops
            <% end %>
            <% recent_tabletops = current_user.tabletops.recent.limit(8).to_a rescue [] %>
            <% if recent_tabletops.any? %>
              <div class="site-nav-dropdown-divider"></div>
              <div class="site-nav-dropdown-eyebrow">Recent</div>
              <% recent_tabletops.each do |t| %>
                <%= link_to tabletop_path(t), class: "site-nav-dropdown-link site-nav-dropdown-link-tabletop" do %>
                  <span class="site-nav-dropdown-tabletop-dot" aria-hidden="true"></span>
                  <span class="site-nav-dropdown-tabletop-name"><%= t.name %></span>
                <% end %>
              <% end %>
            <% end %>
            <div class="site-nav-dropdown-divider"></div>
            <%= link_to tabletops_path(new: 1), class: "site-nav-dropdown-link site-nav-dropdown-link-new" do %>
              <i class="fas fa-plus site-nav-dropdown-icon"></i>New Tabletop
            <% end %>
          </div>
        </div>
      </div>

      <!-- Right cluster -->
      <div class="site-nav-right">
        <div id="global-search-root" class="site-nav-search"></div>
        <div class="site-nav-user" id="user-menu-wrap">
          <button type="button" id="user-menu-button" class="site-nav-avatar" aria-label="Account menu">
            <% if current_user.profile_image.attached? && current_user.profile_image.blob.persisted? %>
              <%= image_tag current_user.profile_image.variant(resize_to_fill: [40, 40]), class: "site-nav-avatar-img" %>
            <% else %>
              <span class="site-nav-avatar-initials"><%= (current_user.email.presence || "?")[0, 2].upcase %></span>
            <% end %>
          </button>
          <div id="user-menu-dropdown" class="site-nav-dropdown">
            <div class="site-nav-dropdown-header"><%= current_user.email %></div>
            <%= link_to collections_path, class: "site-nav-dropdown-link" do %>
              <i class="fas fa-layer-group site-nav-dropdown-icon"></i>Collections
            <% end %>
            <%= link_to tags_path, class: "site-nav-dropdown-link" do %>
              <i class="fas fa-hashtag site-nav-dropdown-icon"></i>Tags
            <% end %>
            <div class="site-nav-dropdown-divider"></div>
            <%= link_to edit_user_registration_path, class: "site-nav-dropdown-link" do %>
              <i class="fas fa-user-pen site-nav-dropdown-icon"></i>Account
            <% end %>
            <%= link_to uploads_path, class: "site-nav-dropdown-link" do %>
              <i class="fas fa-upload site-nav-dropdown-icon"></i>Bulk Uploads
            <% end %>
            <%= link_to sharing_path, class: "site-nav-dropdown-link" do %>
              <i class="fas fa-share-nodes site-nav-dropdown-icon"></i>Sharing
            <% end %>
            <% if current_user.admin? %>
              <div class="site-nav-dropdown-divider"></div>
              <%= link_to admin_dashboard_path, class: "site-nav-dropdown-link" do %>
                <i class="fas fa-gear site-nav-dropdown-icon"></i>Admin
              <% end %>
            <% end %>
            <div class="site-nav-dropdown-divider"></div>
            <%= button_to destroy_user_session_path, method: :delete, class: "site-nav-dropdown-link site-nav-dropdown-button" do %>
              <i class="fas fa-arrow-right-from-bracket site-nav-dropdown-icon"></i>Sign out
            <% end %>
          </div>
        </div>

        <button type="button" class="site-nav-burger" id="mobile-menu-button" aria-label="Open menu">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M3 6h14M3 10h14M3 14h14" stroke-linecap="round" />
          </svg>
        </button>
      </div>
    <% else %>
      <!-- Unauthenticated right cluster -->
      <div class="site-nav-right">
        <%= link_to "Sign in", new_user_session_path, class: "site-nav-link" %>
        <%= link_to "Get started", new_user_registration_path, class: "sp-action sp-action-primary" %>
        <button type="button" class="site-nav-burger" id="mobile-menu-button" aria-label="Open menu">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M3 6h14M3 10h14M3 14h14" stroke-linecap="round" />
          </svg>
        </button>
      </div>
    <% end %>
  </div>

  <!-- Mobile drawer -->
  <div id="mobile-menu" class="site-nav-mobile">
    <% if user_signed_in? %>
      <div class="site-nav-mobile-section">
        <%= link_to dashboard_path, class: "site-nav-mobile-link #{'is-active' if on_dashboard}" do %>Dashboard<% end %>
        <%= link_to concepts_path, class: "site-nav-mobile-link #{'is-active' if active.('/concepts')}" do %>
          <span class="site-nav-dot is-concept" aria-hidden="true"></span>Concepts
        <% end %>
        <%= link_to sources_path, class: "site-nav-mobile-link #{'is-active' if active.('/sources')}" do %>
          <span class="site-nav-dot is-source" aria-hidden="true"></span>Sources
        <% end %>
        <%= link_to people_path, class: "site-nav-mobile-link #{'is-active' if active.('/people')}" do %>
          <span class="site-nav-dot is-person" aria-hidden="true"></span>People
        <% end %>
        <%= link_to notes_path, class: "site-nav-mobile-link #{'is-active' if active.('/notes')}" do %>Notes<% end %>
        <%= link_to tabletops_path, class: "site-nav-mobile-link #{'is-active' if active.('/tabletops')}" do %>Tabletops<% end %>
      </div>
      <div class="site-nav-mobile-section">
        <div class="site-nav-mobile-eyebrow">Account · <%= current_user.email %></div>
        <%= link_to "Collections", collections_path, class: "site-nav-mobile-link" %>
        <%= link_to "Tags", tags_path, class: "site-nav-mobile-link" %>
        <%= link_to "Account", edit_user_registration_path, class: "site-nav-mobile-link" %>
        <%= link_to "Bulk Uploads", uploads_path, class: "site-nav-mobile-link" %>
        <%= link_to "Sharing", sharing_path, class: "site-nav-mobile-link" %>
        <% if current_user.admin? %>
          <%= link_to "Admin", admin_dashboard_path, class: "site-nav-mobile-link" %>
        <% end %>
        <%= button_to "Sign out", destroy_user_session_path, method: :delete, class: "site-nav-mobile-link site-nav-mobile-signout" %>
      </div>
    <% else %>
      <div class="site-nav-mobile-section">
        <%= link_to "Sign in", new_user_session_path, class: "site-nav-mobile-link" %>
        <%= link_to "Get started", new_user_registration_path, class: "site-nav-mobile-link" %>
      </div>
    <% end %>
  </div>
</nav>

<style>
  /* ========== Site nav ========== */
  .site-nav {
    background: var(--paper);
    border-bottom: 1px solid var(--ink-line);
    position: sticky;
    top: 0;
    z-index: 100;
  }
  .site-nav-inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 24px;
    height: 64px;
    display: flex;
    align-items: center;
    gap: 24px;
  }

  /* Brand: logo only */
  .site-nav-brand {
    display: inline-flex;
    align-items: center;
    color: var(--ink);
    text-decoration: none;
    flex-shrink: 0;
  }
  .site-nav-logo {
    width: 40px;
    height: 40px;
    display: block;
    flex-shrink: 0;
  }
  .site-nav-logo-dark { display: none; }
  :root[data-theme="dark"] .site-nav-logo-light,
  .sp-root[data-theme="dark"] .site-nav-logo-light { display: none; }
  :root[data-theme="dark"] .site-nav-logo-dark,
  .sp-root[data-theme="dark"] .site-nav-logo-dark { display: block; }

  /* Right-aligned tail: links + user cluster */
  .site-nav-brand + .site-nav-links,
  .site-nav-brand + .site-nav-right {
    margin-left: auto;
  }

  /* Primary links */
  .site-nav-links {
    display: flex;
    align-items: center;
    gap: 2px;
  }
  .site-nav-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 32px;
    padding: 0 12px;
    font-family: var(--font-body);
    font-size: 13.5px;
    font-weight: 500;
    color: var(--ink-2);
    text-decoration: none;
    border-radius: var(--r-sm);
    transition: background var(--transition-fast), color var(--transition-fast);
    white-space: nowrap;
  }
  .site-nav-link:hover { background: var(--hover); color: var(--ink); }
  .site-nav-link.is-active {
    background: var(--paper-warm);
    color: var(--ink);
    font-weight: 600;
  }

  /* Category dots in nav */
  .site-nav-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .site-nav-dot.is-concept { background: var(--concept); }
  .site-nav-dot.is-source  { background: var(--source); }
  .site-nav-dot.is-person  { background: var(--person); }

  /* Right cluster */
  .site-nav-right {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .site-nav-search {
    width: 280px;
    flex-shrink: 1;
    min-width: 0;
  }
  .site-nav-user { position: relative; }

  /* Tabletops dropdown trigger — same metrics as a regular nav link */
  .site-nav-tabletops { position: relative; }
  .site-nav-tabletops-trigger {
    background: transparent;
    border: none;
    cursor: pointer;
    font: inherit;
    color: var(--ink-2);
  }
  .site-nav-caret {
    display: inline-flex;
    align-items: center;
    color: var(--ink-3);
    transition: transform 0.15s, color 0.15s;
  }
  .site-nav-tabletops-trigger[aria-expanded="true"] .site-nav-caret {
    transform: rotate(180deg);
    color: var(--ink);
  }

  .site-nav-dropdown-tabletops {
    left: 0;
    right: auto;
    min-width: 240px;
    max-width: 320px;
  }
  .site-nav-dropdown-eyebrow {
    padding: 8px 14px 4px;
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .site-nav-dropdown-link-tabletop { padding: 8px 14px; }
  .site-nav-dropdown-tabletop-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-right: 10px;
    border-radius: 50%;
    background: var(--primary);
    flex-shrink: 0;
  }
  .site-nav-dropdown-tabletop-name {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .site-nav-dropdown-link-new { color: var(--primary); font-weight: 500; }
  .site-nav-dropdown-link-new .site-nav-dropdown-icon { color: var(--primary); }

  /* Global search input + dropdown live inside .site-nav-search */
  .gs-root { position: relative; width: 100%; }
  .gs-input-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 34px;
    padding: 0 10px;
    background: var(--paper-soft);
    border: 1px solid var(--ink-line);
    border-radius: var(--r-md);
    color: var(--ink-3);
    transition: background var(--transition-fast), border-color var(--transition-fast), color var(--transition-fast);
  }
  .gs-input-wrap:focus-within,
  .gs-input-wrap.is-open {
    background: var(--paper);
    border-color: var(--ink-3);
    color: var(--ink);
  }
  .gs-input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    font-family: var(--font-body);
    font-size: 13px;
    color: var(--ink);
    min-width: 0;
  }
  .gs-input::placeholder { color: var(--ink-3); }
  .gs-kbd {
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--ink-3);
    background: var(--paper);
    border: 1px solid var(--ink-line);
    padding: 1px 5px;
    border-radius: 2px;
    flex-shrink: 0;
  }

  .gs-dropdown {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    right: 0;
    background: var(--paper);
    border: 1px solid var(--ink-line);
    border-radius: var(--r-md);
    box-shadow: var(--shadow-lg);
    max-height: min(70vh, 520px);
    overflow-y: auto;
    z-index: 200;
    padding: 6px 0;
  }
  .gs-status {
    padding: 14px 16px;
    font-family: var(--font-body);
    font-size: 13px;
    color: var(--ink-3);
    text-align: center;
  }
  .gs-status em { font-family: var(--font-display); color: var(--ink); font-style: italic; }
  .gs-group { padding: 4px 0; }
  .gs-group + .gs-group { border-top: 1px solid var(--ink-line-soft); }
  .gs-group-label {
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
    padding: 6px 16px 4px;
  }
  .gs-row {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 7px 16px;
    text-decoration: none;
    color: var(--ink);
    transition: background var(--transition-fast);
  }
  .gs-row:hover { background: var(--paper-soft); }
  .gs-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--ink-3);
    flex-shrink: 0;
    margin-top: 7px;
  }
  .gs-dot.is-concept { background: var(--concept); }
  .gs-dot.is-source  { background: var(--source); }
  .gs-dot.is-person  { background: var(--person); }
  .gs-row-text { display: flex; flex-direction: column; min-width: 0; flex: 1; }
  .gs-row-title {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 500;
    color: var(--ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .gs-row-sub {
    font-family: var(--font-body);
    font-size: 11.5px;
    color: var(--ink-3);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .gs-all {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 10px 16px;
    margin-top: 4px;
    border-top: 1px solid var(--ink-line-soft);
    background: var(--paper-soft);
    font-family: var(--font-body);
    font-size: 12.5px;
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
  }
  .gs-all:hover { background: var(--paper-warm); }
  .gs-all-arrow { color: var(--ink-3); }

  /* Avatar */
  .site-nav-avatar {
    width: 34px;
    height: 34px;
    padding: 0;
    background: var(--ink);
    color: var(--paper);
    border: none;
    border-radius: var(--r-pill);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    transition: background var(--transition-fast);
  }
  .site-nav-avatar:hover { background: var(--ink-2); }
  .site-nav-avatar-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .site-nav-avatar-initials {
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  /* Burger */
  .site-nav-burger {
    display: none;
    width: 34px;
    height: 34px;
    background: transparent;
    border: 1px solid var(--ink-line);
    border-radius: var(--r-md);
    color: var(--ink-2);
    cursor: pointer;
    align-items: center;
    justify-content: center;
  }
  .site-nav-burger:hover { background: var(--hover); color: var(--ink); }

  /* Dropdown */
  .site-nav-dropdown {
    display: none;
    position: absolute;
    right: 0;
    top: calc(100% + 8px);
    background: var(--paper);
    border: 1px solid var(--ink-line);
    border-radius: var(--r-md);
    box-shadow: var(--shadow-lg);
    min-width: 220px;
    overflow: hidden;
    z-index: 200;
  }
  .site-nav-dropdown.is-open { display: block; }
  .site-nav-dropdown-header {
    padding: 10px 14px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--ink-3);
    border-bottom: 1px solid var(--ink-line);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .site-nav-dropdown-link {
    display: flex;
    align-items: center;
    width: 100%;
    padding: 9px 14px;
    font-family: var(--font-body);
    font-size: 13px;
    color: var(--ink);
    text-decoration: none;
    background: transparent;
    border: none;
    cursor: pointer;
    text-align: left;
  }
  .site-nav-dropdown-link:hover { background: var(--hover); }
  .site-nav-dropdown-icon {
    width: 16px;
    margin-right: 10px;
    color: var(--ink-3);
    font-size: 13px;
    text-align: center;
  }
  .site-nav-dropdown-button {
    color: var(--error);
  }
  .site-nav-dropdown-button .site-nav-dropdown-icon { color: var(--error); }
  .site-nav-dropdown-divider {
    height: 1px;
    background: var(--ink-line-soft);
    margin: 4px 0;
  }

  /* Mobile drawer */
  .site-nav-mobile {
    display: none;
    border-top: 1px solid var(--ink-line);
    background: var(--paper);
  }
  .site-nav-mobile.is-open { display: block; }
  .site-nav-mobile-section {
    padding: 8px 16px;
    border-bottom: 1px solid var(--ink-line-soft);
  }
  .site-nav-mobile-section:last-child { border-bottom: none; }
  .site-nav-mobile-eyebrow {
    font-family: var(--font-body);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
    padding: 12px 12px 6px;
  }
  .site-nav-mobile-link {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 11px 12px;
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--ink);
    text-decoration: none;
    border-radius: var(--r-sm);
    background: transparent;
    border: none;
    width: 100%;
    text-align: left;
    cursor: pointer;
  }
  .site-nav-mobile-link:hover { background: var(--hover); }
  .site-nav-mobile-link.is-active { background: var(--paper-warm); font-weight: 600; }
  .site-nav-mobile-signout { color: var(--error); }

  /* Responsive
     iPad portrait (~810px) and below collapses to a burger.
     iPad landscape (1024px+) keeps the full nav. */
  @media (max-width: 900px) {
    .site-nav-links { display: none; }
    .site-nav-burger { display: inline-flex; }
    .site-nav-search { width: 200px; }
  }
  @media (max-width: 720px) {
    .site-nav-search { display: none; }
  }
  @media (max-width: 600px) {
    .site-nav-inner { padding: 0 16px; gap: 12px; }
    .site-nav-logo { width: 36px; height: 36px; }
  }
  @media (max-width: 380px) {
    .site-nav-inner { padding: 0 12px; }
    .site-nav-logo { width: 32px; height: 32px; }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var burger = document.getElementById('mobile-menu-button');
    var drawer = document.getElementById('mobile-menu');
    if (burger && drawer) {
      burger.addEventListener('click', function () {
        drawer.classList.toggle('is-open');
      });
    }

    var userBtn = document.getElementById('user-menu-button');
    var userMenu = document.getElementById('user-menu-dropdown');
    if (userBtn && userMenu) {
      userBtn.addEventListener('click', function (e) {
        e.stopPropagation();
        userMenu.classList.toggle('is-open');
      });
      document.addEventListener('click', function (e) {
        if (!userBtn.contains(e.target) && !userMenu.contains(e.target)) {
          userMenu.classList.remove('is-open');
        }
      });
    }

    var tBtn = document.getElementById('tabletops-menu-button');
    var tMenu = document.getElementById('tabletops-menu-dropdown');
    if (tBtn && tMenu) {
      var setOpen = function (open) {
        tMenu.classList.toggle('is-open', open);
        tBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
      };
      tBtn.addEventListener('click', function (e) {
        e.stopPropagation();
        e.preventDefault();
        setOpen(!tMenu.classList.contains('is-open'));
      });
      document.addEventListener('click', function (e) {
        if (!tBtn.contains(e.target) && !tMenu.contains(e.target)) setOpen(false);
      });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') setOpen(false);
      });
    }
  });
</script>
